[node name="LazerNfcIntro" instance=ExtResource("1_intro")]
cards = Array[String](["The little laboratory has a very big idea.", "Every robot has a colour, a shape, and a sound.\nRemember the pattern. Then light them up.", "Keys or touch work straight away.\nOn Android, bind at least three NFC tags to play away from the screen.", "Keep tags comfortably within reach and at least 15 cm apart.\nTap with the upper back of your phone. Lift before tapping again.", "Learn the sounds. Chase a clean sweep.\nOne more experiment?"])
